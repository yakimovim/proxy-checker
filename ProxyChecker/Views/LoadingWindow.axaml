<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:asts="using:ProxyChecker.Interfaces.Resources"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ProxyChecker.LoadingWindow"
        Width="400" Height="300"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Icon="avares://ProxyChecker.Interfaces/Resources/proxy-checker.ico"
        Title="{x:Static asts:Resource.LoadingWindowTitle}">
  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static asts:Resource.LoadingMessage}" />
</Window>
